NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SITE_URL=http://localhost:3000

# Comma-separated dev hostnames other than localhost, for example a LAN or Tailscale IP
ALLOWED_DEV_ORIGINS=

# Server-only garmin_mcp REST API origin, for example the internal Docker service URL
GARMIN_API_URL=

# Server-only rollout; keep false until onboarding screens #33–#38 are ready
ONBOARDING_ENABLED=false

# Server-only credential used solely by the constrained Garmin/profile completion RPC (#42)
# Configure through the secret manager; never prefix with NEXT_PUBLIC_
SUPABASE_ONBOARDING_COMPLETION_KEY=

# Server-only key for the onboarding insight phrasing model (OpenCode Go); optional, deterministic sentences are used without it
OPENCODE_API_KEY=

# Server-only Anthropic credential for Claude Managed Agents coaching sessions (web process)
ANTHROPIC_API_KEY=

# Server-only internal URL of the stride-coach-worker service, for example http://stride-coach-worker:3400 (web process)
COACH_WORKER_URL=

# Worker process only, never in the web process: pooler session-mode URL of the coach worker login role
COACH_WORKER_DATABASE_URL=
COACH_WORKER_HOST=127.0.0.1
COACH_WORKER_PORT=3400
